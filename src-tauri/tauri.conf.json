{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Pokemon Desktop Pet",
  "productName": "Pokemon Desktop Pet",
  "version": "1.0.1",
  "identifier": "dev.local.fuecocopet",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pokemon pet",
        "width": 300,
        "height": 240,
        "x": 400,
        "y": 400,
        "visible": false,
        "focusable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installerIcon": "icons/icon.ico" } }
  }
}
